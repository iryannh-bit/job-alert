# ═══════════════════════════════════════════════════════════════
# VARIABLES D'ENVIRONNEMENT — copie ce fichier en .env (local)
# ou configure-les comme GitHub Secrets (déploiement)
# NE JAMAIS committer le .env dans le repo !
# ═══════════════════════════════════════════════════════════════

# ── API Anthropic (pour le filtre IA et les futures lettres) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── JobTeaser ESSEC (désactivé pour l'instant) ───────────────
# Décommente et renseigne ces variables quand tu veux l'activer :
# JOBTEASER_EMAIL=b00827960@essec.edu
# JOBTEASER_PASSWORD=TON_MOT_DE_PASSE

# ── Gmail — compte expéditeur des alertes ─────────────────────
# Crée un compte dédié (ex: job.alert.sender@gmail.com)
# ou utilise un de tes comptes avec un App Password
# Tuto App Password : myaccount.google.com → Sécurité → Mots de passe d'application
SMTP_EMAIL=job.alert.sender@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx   # App Password Gmail (16 caractères)

# ── Adresses de réception ─────────────────────────────────────
EMAIL_POUR_PLUS_TARD=iryannh@gmail.com
EMAIL_RECHERCHE=iryannhassim@gmail.com

# ── Excel (laisser vide pour fichier local suivi_stages.xlsx) ─
# Pour Google Drive : partage en "Toute personne avec le lien peut voir"
# puis copie l'ID depuis l'URL (drive.google.com/file/d/XXXXX/view)
GOOGLE_DRIVE_FILE_ID=

# ── Chemin local de l'Excel (si pas Google Drive) ────────────
EXCEL_PATH=suivi_stages.xlsx

# ── Activer l'envoi du summary (géré automatiquement) ────────
SEND_SUMMARY=false

# ── Cover letter (désactivé pour l'instant) ──────────────────
COVER_LETTER_ENABLED=false
